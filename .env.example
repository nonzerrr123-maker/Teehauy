# Neon/PostgreSQL connection string. Never commit a real credential.
DATABASE_URL=

# Optional HTTPS JSON provider for lottery draw history.
# Expected payload: [{"date":"01 ส.ค.","first":"123456","bottom":"78"}]
# or {"draws":[...]} — `top` is optional and defaults to the final 2 digits of first prize.
LOTTERY_RESULTS_JSON_URL=
